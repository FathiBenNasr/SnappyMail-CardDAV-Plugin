<?php

class MailbuxCardDAVAutoPlugin extends \RainLoop\Plugins\AbstractPlugin
{
const
NAME     = 'Mailbux CardDAV Auto',
VERSION  = '1.4',
RELEASE  = '2025-11-12',
CATEGORY = 'Contacts',
DESCRIPTION = 'Auto-configures CardDAV sync with Mailbux server (switches per account)',
REQUIRED = '2.0.0';

private $lastConfiguredEmail = null;

public function Init() : void
{
// Hook into login.success - runs for main login AND added accounts
$this->addHook('login.success', 'AutoConfigureCardDAV');

// Hook after JSON responses to catch account switch
$this->addHook('filter.json-response', 'OnJsonResponse');
}

/**
 * Called after JSON API response - check if it was AccountSwitch
 */
public function OnJsonResponse(string $sAction, array &$aResponseItem)
{
if ($sAction === 'AccountSwitch' && !empty($aResponseItem['Result'])) {
// Account switch succeeded - update CardDAV
$oAccount = $this->Manager()->Actions()->getAccountFromToken();
if ($oAccount) {
$this->AutoConfigureCardDAV($oAccount);
}
}
}

/**
 * Auto-configure CardDAV sync for newly logged-in user
 */
public function AutoConfigureCardDAV(\RainLoop\Model\Account $oAccount)
{
if (!$oAccount || !$oAccount->Email()) {
return;
}

$sEmail = $oAccount->Email();

// Only update if email changed (avoid updating on every request)
if ($this->lastConfiguredEmail === $sEmail) {
return;
}

$this->lastConfiguredEmail = $sEmail;
$oActions = $this->Manager()->Actions();

try {
// Get storage provider
$oStorageProvider = $oActions->StorageProvider();
if (!$oStorageProvider) {
\error_log('[Mailbux CardDAV] StorageProvider not available');
return;
}

// Always update CardDAV to match current account email
$sCardDAVUrl = "https://my.mailbux.com/dav/card/{$sEmail}/default";

// Get account credentials from additionalaccounts storage
$sPassword = null;
$sPasswordHMAC = null;

// Try to get password from additionalaccounts file
$aAdditionalAccounts = $this->getAdditionalAccounts($oAccount, $oStorageProvider);
if (isset($aAdditionalAccounts[$sEmail])) {
// Found in additional accounts - reuse encrypted password and HMAC
$sPassword = $aAdditionalAccounts[$sEmail]['pass'];
$sPasswordHMAC = $aAdditionalAccounts[$sEmail]['hmac'];
\error_log('[Mailbux CardDAV] Using password from additional accounts for ' . $sEmail);
} else {
// Primary account - encrypt password
$sRawPassword = $oAccount->ImapPass();
$sCryptKey = $oAccount->CryptKey();
$sPassword = \SnappyMail\Crypt::EncryptToJSON($sRawPassword, $sCryptKey);
$sPasswordHMAC = \hash_hmac('sha1', $sPassword, $sCryptKey);
\error_log('[Mailbux CardDAV] Using password from primary login for ' . $sEmail);
}

// Prepare CardDAV data with proper encryption and HMAC
$aCardDAVData = [
'Mode' => 1, // Enable sync
'User' => $sEmail,
'Password' => $sPassword, // Encrypted password
'PasswordHMAC' => $sPasswordHMAC, // HMAC for verification
'Url' => $sCardDAVUrl
];

// Save CardDAV sync data
$bResult = $oStorageProvider->Put($oAccount,
\RainLoop\Providers\Storage\Enumerations\StorageType::CONFIG,
'contacts_sync',
\json_encode($aCardDAVData)
);

if ($bResult) {
\error_log('[Mailbux CardDAV] Configured CardDAV for ' . $sEmail . ': ' . $sCardDAVUrl);
} else {
\error_log('[Mailbux CardDAV] Failed to save configuration for ' . $sEmail);
}

} catch (\Exception $e) {
\error_log('[Mailbux CardDAV] Exception: ' . $e->getMessage());
}
}

/**
 * Get additional accounts from storage
 */
private function getAdditionalAccounts(\RainLoop\Model\Account $oAccount, $oStorageProvider)
{
try {
$mData = $oStorageProvider->Get($oAccount,
\RainLoop\Providers\Storage\Enumerations\StorageType::CONFIG,
'additionalaccounts'
);

if ($mData && \is_string($mData)) {
$aData = \json_decode($mData, true);
return \is_array($aData) ? $aData : [];
}
} catch (\Exception $e) {
\error_log('[Mailbux CardDAV] Failed to read additional accounts: ' . $e->getMessage());
}

return [];
}
}
